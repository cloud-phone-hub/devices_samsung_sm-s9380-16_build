# Samsung SM-S9380（Galaxy S25 Ultra）云机 fstab
#
# 名字取真机 ro.hardware=qcom（官方 vendor/etc/fstab.qcom + boot cmdline
# androidboot.hardware=qcom），使 init 走 fstab.qcom + init.qcom.rc。
# 内容为 lineage-23.2 virtio 基座（/vendor 被内核重定向到 /mnt/vendor）的等价集，
# 另加 vdc -> /mnt/vendor（lineage vendor 的 patch.img 载体，first_stage_mount）。
# 本文件由 build-boot.py 注入 boot ramdisk 的 first_stage fstab，并被
# build-patch.py 带进 patch.img 的 /etc/fstab.qcom（二阶段 mount_all 读取），单一来源。

# Patch（vdc）：lineage vendor 内容载体，/vendor 的重定向目标
/dev/block/vdc /mnt/vendor ext4 ro first_stage_mount

# EFI
/dev/block/by-name/EFI /mnt/vendor/EFI vfat rw,discard,shortname=lower,uid=0,gid=0,dmask=007,fmask=117,context=u:object_r:efi_file:s0 nofail

# Misc
/dev/block/by-name/misc /misc emmc defaults defaults

# Metadata
/dev/block/by-name/metadata /metadata ext4 nodev,noatime,nosuid,discard,data=journal,commit=1 check,formattable,first_stage_mount,metadata_csum

# Persist
/dev/block/by-name/persist /mnt/vendor/persist vfat rw,sync,shortname=lower,uid=1000,gid=1000,dmask=007,fmask=117,context=u:object_r:persist_file:s0 formattable

# CD-ROM
/devices/*/block/sr* auto auto defaults voldmanaged=cdrom:auto

# USB
/devices/*/usb* auto auto defaults voldmanaged=usb:auto

# ZRAM
/dev/block/zram0 none swap defaults zramsize=50%
# Userdata (on separate disk)
# keydirectory= 必须保留：三星 init 的 FBE 启用链（vdc cryptfs enablefilecrypto →
# vold KeyStorage::storeKey）要取 ROT，缺它会以 security.fbe.fail_cause=K00R 失败并
# 'Rebooting into recovery, reason: enablefilecrypto_failed'（实测 2026-10-10，
# instance 20）。故不能靠"关掉 metadata 加密"绕开 keystore2 的 SEH KeyMint 依赖。
/dev/block/vdb /data ext4 nodev,noatime,nosuid,discard latemount,check,quota,formattable,fileencryption,keydirectory=/metadata/vold/metadata_encryption,checkpoint=block
/dev/block/vdb /data f2fs nodev,noatime,nosuid,discard,reserve_root=32768 latemount,check,quota,formattable,fileencryption,keydirectory=/metadata/vold/metadata_encryption,fscompress,checkpoint=fs

# SD card (recovery only)
/dev/block/sda /sdcard vfat ro,defaults recoveryonly

# VirtioFS
share /mnt/vendor/shared virtiofs nosuid,nodev,noatime nofail
share /mnt/vendor/shared 9p trans=virtio,version=9p2000.L,nosuid,nodev,noatime nofail
# Super（官方 Samsung super 零改动）
odm /odm ext4 noatime,ro logical,first_stage_mount,slotselect
odm /odm erofs noatime,ro logical,first_stage_mount,slotselect
product /product ext4 noatime,ro logical,first_stage_mount,slotselect
product /product erofs noatime,ro logical,first_stage_mount,slotselect
system /system ext4 noatime,ro logical,first_stage_mount,slotselect
system /system erofs noatime,ro logical,first_stage_mount,slotselect
system_dlkm /system_dlkm ext4 noatime,ro,errors=panic logical,first_stage_mount,slotselect
system_dlkm /system_dlkm erofs ro logical,first_stage_mount,slotselect
system_ext /system_ext ext4 noatime,ro logical,first_stage_mount,slotselect
system_ext /system_ext erofs noatime,ro logical,first_stage_mount,slotselect
vendor /vendor ext4 noatime,ro logical,first_stage_mount,slotselect
vendor /vendor erofs noatime,ro logical,first_stage_mount,slotselect
vendor_dlkm /vendor_dlkm ext4 noatime,ro,errors=panic logical,first_stage_mount,slotselect
vendor_dlkm /vendor_dlkm erofs ro logical,first_stage_mount,slotselect

# Boot
/dev/block/by-name/boot /boot emmc defaults slotselect
/dev/block/by-name/vendor_boot /vendor_boot emmc defaults slotselect