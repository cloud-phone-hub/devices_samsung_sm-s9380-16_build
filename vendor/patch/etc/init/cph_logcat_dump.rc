service logcat_dump /system/bin/sh /vendor/bin/logcat-dump
    class main
    user root
    group root
    oneshot
    seclabel u:r:pioneer:s0

# 提前到 systemserver 阶段就抓 logcat，覆盖开机循环/SystemServer 反复重启场景
on property:sys.boot_progress.systemserver=1
    start logcat_dump

on property:sys.boot_completed=1
    start logcat_dump
